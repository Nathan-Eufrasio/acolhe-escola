# Copie este arquivo com o nome ".env":   copy .env.example .env
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).
#
# Senhas de DESENVOLVIMENTO: cada pessoa usa no proprio computador,
# com o proprio banco. Trocar todas antes de publicar o site.

# Senha do administrador geral do MySQL (so para manutencao)
MYSQL_ROOT_PASSWORD=senharoot

# Banco e usuario que o backend (Node) vai usar
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=AcolheEscola
DB_USER=acolhe
DB_PASSWORD=senhaapp

# Chave que assina os tokens de login (JWT).
# Gere a sua com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_esta_chave
